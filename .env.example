# HuoYu 环境变量示例。复制为 .env.local 后填入真实值。

# 后台登录与会话
PASSWORD=your_admin_password
NEXTAUTH_SECRET=your_random_nextauth_secret

# Upstash Redis 连接。手动创建 Upstash 时使用这一组。
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Vercel Marketplace 连接 Upstash 时通常使用这一组。
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# 站点配置在 Redis 中使用的 key，不填时默认 huoyu:settings。
SETTINGS_REDIS_KEY=huoyu:settings

# 第三方服务密钥，按需填写。
GITHUB_TOKEN=your_github_token
STEAM_API_KEY=your_steam_api_key
NETEASE_MUSIC_U=your_netease_music_u
WAKATIME_API_KEY=your_wakatime_api_key
WEGAME_TGP_ID=your_wegame_tgp_id
WEGAME_COOKIE=your_wegame_cookie
