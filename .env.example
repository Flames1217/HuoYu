# HuoYu 环境变量示例。复制为 .env.local 后填入真实值。

# 后台登录与会话
PASSWORD=your_admin_password
NEXTAUTH_SECRET=your_random_nextauth_secret
CRON_SECRET=your_random_cron_secret
# 可选；留空时 AI 同步接口复用 CRON_SECRET。
AI_SYNC_SECRET=

# Upstash Redis 连接。手动创建 Upstash 时使用这一组。
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Vercel Marketplace 连接 Upstash 时通常使用这一组。
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# 站点配置在 Redis 中使用的 key，不填时默认 huoyu:settings。
SETTINGS_REDIS_KEY=huoyu:settings
AI_SESSIONS_REDIS_KEY=huoyu:ai:sessions

# 可选：按每百万 Token 的 API 单价估算等价成本；模型无公开价格时留空。
AI_INPUT_USD_PER_MILLION=
AI_CACHED_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# 第三方服务密钥，按需填写。
GITHUB_TOKEN=your_github_token
STEAM_API_KEY=your_steam_api_key
STEAM_USER_ID=your_steam_user_id
NETEASE_USER_ID=your_netease_user_id
NETEASE_MUSIC_U=your_netease_music_u
NETEASE_API_BASE_URL=https://api-cloudmusic.viper3.top
WAKATIME_API_KEY=your_wakatime_api_key
WEGAME_TGP_ID=your_wegame_tgp_id
WEGAME_COOKIE=your_wegame_cookie

# RSS 区块使用的公开 feed 地址，按需填写。
NEXT_PUBLIC_FEED_URL=https://example.com/feed

# Tolgee 前端调试配置。正常访问会优先使用本地语言包；不要把服务端/PAT key 放进 NEXT_PUBLIC_*。
NEXT_PUBLIC_TOLGEE_API_URL=https://tolgee.example.com
NEXT_PUBLIC_TOLGEE_API_KEY=your_tolgee_project_client_key
NEXT_PUBLIC_TOLGEE_PROJECT_ID=1

# Tolgee CLI / 同步脚本使用的服务端配置，不要暴露到前端。
TOLGEE_API_URL=https://tolgee.example.com
TOLGEE_API_KEY=your_tolgee_server_api_key
TOLGEE_PROJECT_ID=1
TOLGEE_SKIP_NEW_KEYS=false
TOLGEE_SYNC_CONCURRENCY=1

# 本地翻译补全脚本使用的 MTranServer 接口。
MTRAN_API_URL=https://tran.viper3.top
MTRAN_API_KEY=your_translation_api_key
